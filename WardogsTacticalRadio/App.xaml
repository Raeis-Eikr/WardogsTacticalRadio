<Application x:Class="WardogsTacticalRadio.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="Bg" Color="#10120F"/>
        <SolidColorBrush x:Key="Panel" Color="#191C18"/>
        <SolidColorBrush x:Key="Panel2" Color="#242720"/>
        <SolidColorBrush x:Key="Metal" Color="#36382F"/>
        <SolidColorBrush x:Key="Bezel" Color="#5A5747"/>
        <SolidColorBrush x:Key="Lcd" Color="#A8C53B"/>
        <SolidColorBrush x:Key="LcdDark" Color="#17210B"/>
        <SolidColorBrush x:Key="Text" Color="#D9D7C9"/>
        <SolidColorBrush x:Key="Muted" Color="#85877C"/>
        <SolidColorBrush x:Key="Green" Color="#70E35B"/>
        <SolidColorBrush x:Key="Amber" Color="#E3A733"/>
        <SolidColorBrush x:Key="Red" Color="#E04C42"/>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="FontFamily" Value="Consolas"/>
        </Style>
        <Style TargetType="Button" x:Key="TacticalButton">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Background" Value="#242820"/>
            <Setter Property="BorderBrush" Value="#5D6053"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="3"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#34392E"/>
                    <Setter Property="BorderBrush" Value="#8B8B75"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TextBox" x:Key="TacticalInput">
            <Setter Property="Foreground" Value="#E6E6D8"/>
            <Setter Property="Background" Value="#0F120E"/>
            <Setter Property="BorderBrush" Value="#4F5347"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontFamily" Value="Consolas"/>
        </Style>
        <Style TargetType="PasswordBox" x:Key="TacticalPassword">
            <Setter Property="Foreground" Value="#E6E6D8"/>
            <Setter Property="Background" Value="#0F120E"/>
            <Setter Property="BorderBrush" Value="#4F5347"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontFamily" Value="Consolas"/>
        </Style>
    </Application.Resources>
</Application>
